{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nookly",
  "version": "0.0.0",
  "identifier": "com.nookly.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nookly",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 24 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/files/**", "$APPDATA/bookmark-previews/**", "$APPDATA/office-previews/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/Nookly.icon", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEODIxMTZDOUNGM0Q1OTQKUldTVTFmT2NiQkdDYmRJNzRNZHVxcGpQN3lab29xNWxVWVF0V3Jvd2FIS01VMjVWRUFHSU80VU4K",
      "endpoints": ["https://github.com/Daanieeel/nookly/releases/latest/download/latest.json"]
    }
  }
}
