{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/config/oxlint/base.json"],
  "plugins": ["jsx-a11y", "react-perf"],
  "ignorePatterns": [
    "**/dist/**",
    "**/target/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/anti-slop/**"
  ]
}
