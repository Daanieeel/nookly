# Golden SQLite files are never diffed or merged as text.
apps/desktop/src-tauri/src/db/golden/*.db binary
# Snapshots are compared as text, so they are always checked out with LF.
apps/desktop/src-tauri/src/cli/snapshots/*.json text eol=lf
# Generated fixtures are compared byte for byte by the desktop's tests, so always LF.
packages/shared/src/generated/** text eol=lf
