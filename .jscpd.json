{
  "path": [
    "packages/frontend/src",
    "packages/ui/src",
    "packages/shared/src",
    "apps/desktop/src-tauri/src",
    "apps/server/src",
    "apps/mobile/src"
  ],
  "format": ["typescript", "tsx", "rust"],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*_tests.rs",
    "**/series_scenarios.rs",
    "**/node_modules/**",
    "**/target/**",
    "**/generated/**"
  ],
  "minLines": 12,
  "minTokens": 90,
  "reporters": ["console"],
  "gitignore": true,
  "threshold": 1
}
