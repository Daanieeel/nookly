  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit && cargo check --quiet --manifest-path src-tauri/Cargo.toml",
    "lint:js": "NODE_OPTIONS=--experimental-strip-types oxlint .",
    "lint:rust": "cargo clippy --quiet --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint": "bun run lint:js && bun run lint:rust",
    "format:js": "NODE_OPTIONS=--experimental-strip-types oxfmt .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format": "bun run format:js && bun run format:rust",
    "format:check:js": "NODE_OPTIONS=--experimental-strip-types oxfmt --check .",
    "format:check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:check": "bun run format:check:js && bun run format:check:rust"
  },
