{
  "expo": {
    "name": "Nookly",
    "slug": "nookly",
    "scheme": "nookly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.nookly.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.nookly.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store", "expo-font"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
