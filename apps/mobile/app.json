{
  "expo": {
    "name": "Nookly",
    "slug": "nookly",
    "scheme": "nookly",
    "version": "0.3.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.nookly.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.nookly.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
