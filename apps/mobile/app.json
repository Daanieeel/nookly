{
  "expo": {
    "name": "Nookly",
    "slug": "nookly",
    "scheme": "nookly",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.nookly.mobile",
      "icon": "./assets/Nookly.icon",
      "supportsTablet": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSCameraUsageDescription": "Nookly uses the camera to scan documents into your files."
      }
    },
    "android": {
      "package": "app.nookly.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "./plugins/scene-lifecycle",
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#111111"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
