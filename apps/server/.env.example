# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required to run.

# Production (docker-compose.prod.yml): the public domain, with DNS pointing here.
DOMAIN=sync.example.com
POSTGRES_PASSWORD=change-me

# Postgres connection (docker-compose.prod.yml builds it from POSTGRES_PASSWORD).
DATABASE_URL=postgres://nookly:nookly@localhost:5432/nookly
# Signs access tokens: openssl rand -base64 48
JWT_SECRET=
# Where people reach the server, for links in emails.
PUBLIC_URL=http://localhost:3000
PORT=3000
# Browser origins allowed to call the API (the desktop app's by default).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Read the client address from X-Forwarded-For (behind Caddy).
TRUST_PROXY=false

# console prints emails to the log (development only), smtp sends them.
MAILER=console
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Nookly <no-reply@example.com>

MAX_BODY_BYTES=8388608
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
