{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nookly",
  "version": "0.31.7",
  "identifier": "com.nookly.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nookly",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 24 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/files/**",
          "$APPDATA/bookmark-previews/**",
          "$APPDATA/office-previews/**",
          "$APPDATA/recipe-banners/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/512x512.png",
      "icons/256x256.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/48x48.png",
      "icons/32x32.png"
    ],
    "linux": {
      "deb": {
        "files": { "/usr/share/icons/hicolor/scalable/apps/nookly.svg": "icons/nookly.svg" }
      },
      "rpm": {
        "files": { "/usr/share/icons/hicolor/scalable/apps/nookly.svg": "icons/nookly.svg" }
      },
      "appimage": {
        "files": { "/usr/share/icons/hicolor/scalable/apps/nookly.svg": "icons/nookly.svg" }
      }
    },
    "macOS": {
      "files": { "Resources/Assets.car": "icons/Assets.car" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEODIxMTZDOUNGM0Q1OTQKUldTVTFmT2NiQkdDYmRJNzRNZHVxcGpQN3lab29xNWxVWVF0V3Jvd2FIS01VMjVWRUFHSU80VU4K",
      "endpoints": ["https://github.com/Daanieeel/nookly/releases/latest/download/latest.json"]
    }
  }
}
