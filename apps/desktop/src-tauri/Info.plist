<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>Nookly</string>
	<!-- Required on macOS 12+: tells AppKit our app has opted in to secure
	     window state coding. Without this, NSApplication calls abort() on
	     second launch when it tries to restore the previous session. -->
	<key>NSApplicationSupportsSecureRestorableState</key>
	<true/>
	<!-- Do not restore windows from the previous session. Nookly always
	     opens fresh, so there is no state to restore and no use having
	     the OS try. -->
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
</dict>
</plist>
