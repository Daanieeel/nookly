# Copy to .env. Every value below works as is for local development
# (`docker compose up -d`, then `bun run stack`). Never commit .env.

# --- Ports on this machine (docker-compose.yml) ---
PORT=3000
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Postgres ---
POSTGRES_USER=nookly
POSTGRES_PASSWORD=nookly
POSTGRES_DB=nookly
# Built from the values above when unset. In Docker the server reaches postgres:5432.
# DATABASE_URL=postgres://nookly:nookly@127.0.0.1:5433/nookly

# --- Accounts (better-auth) ---
# Signs sessions. At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=development-only-secret-change-me-in-production-please
# Where people reach the server, for links in emails (password reset, confirm email).
PUBLIC_URL=http://localhost:3000
# How long a device stays signed in without being used; each use renews it.
SESSION_TTL_DAYS=60
# OAuth providers turn on when both values are set (none are needed to run).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Files (any S3 API: MinIO here, AWS S3 in production) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nookly
S3_ACCESS_KEY_ID=nookly
S3_SECRET_ACCESS_KEY=nookly-dev-secret
# MinIO needs path style URLs. Set false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Make the bucket (with versioning) on start. For development only.
S3_CREATE_BUCKET=true
# The largest single file, in bytes (512 MB).
MAX_BLOB_BYTES=536870912

# --- Mail ---
# console prints emails (with their links) to the server log: the stub for password
# reset without a mail provider. smtp sends them.
MAILER=console
SMTP_URL=
MAIL_FROM=Nookly <no-reply@localhost>

# --- Server ---
# Browser origins allowed to call the API (the desktop app's).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Read the client address from X-Forwarded-For (behind a reverse proxy).
TRUST_PROXY=false
MAX_BODY_BYTES=8388608
LOG_LEVEL=info
