{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.ts"]
    },
    "apps/desktop": {},
    "packages/frontend": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {},
    "packages/config": {},
    "packages/shared": {
      "entry": ["src/**/*.test.ts", "src/*/index.ts", "src/schema.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
