{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../config/oxlint/base.json"],
  "plugins": ["jsx-a11y", "react-perf"],
  "settings": {
    "shadcn": {
      "ui": "@nookly/ui/components"
    },
    "better-tailwindcss": {
      "entryPoint": "packages/frontend/src/styles.css"
    }
  },
  "overrides": [
    {
      "files": ["src/features/notes/language-marks.tsx"],
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-inline-styles": "off"
      }
    }
  ]
}
